{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Só o Postgres decide o 503 (o host reinicia a API). O Redis aparece no\ncorpo, mas não derruba a API: sem ele, o rate limit deixa passar\n(decisões 97, item 3, e 134).",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OriginNotAllowedErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedErrorBody"
                }
              }
            }
          }
        },
        "summary": "Sair: encerra a sessão deste aparelho (RN09).",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OriginNotAllowedErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedErrorBody"
                }
              }
            }
          }
        },
        "summary": "Sair de todos os aparelhos, inclusive este (RN09).",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login-challenges": {
      "post": {
        "operationId": "LoginController_request_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginChallengeBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestLoginChallengeResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OriginNotAllowedErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RateLimitedErrorBody"
                    },
                    {
                      "$ref": "#/components/schemas/TooSoonErrorBody"
                    },
                    {
                      "$ref": "#/components/schemas/TooManyCodeRequestsErrorBody"
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Pede o código e o botão de acesso por e-mail (RN01 a RN04, RN06).",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login-challenges/verify": {
      "post": {
        "operationId": "LoginController_verify_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyLoginChallengeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyLoginChallengeResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCodeErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OriginNotAllowedErrorBody"
                    },
                    {
                      "$ref": "#/components/schemas/UserBlockedErrorBody"
                    }
                  ]
                }
              }
            }
          },
          "410": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ChallengeExpiredErrorBody"
                    },
                    {
                      "$ref": "#/components/schemas/ChallengeLockedErrorBody"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedErrorBody"
                }
              }
            }
          }
        },
        "summary": "Confirma pelo código ou pelo botão e abre a sessão (RN01, RN02, RN05, RN06, RN08, RN11).",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/google": {
      "get": {
        "operationId": "GoogleLoginController_start_v1",
        "parameters": [
          {
            "name": "origin",
            "required": false,
            "in": "query",
            "description": "De onde a pessoa veio (RN06); padrão none.",
            "schema": {
              "type": "string",
              "enum": [
                "invite",
                "referral",
                "couple_signup",
                "planner_signup",
                "none"
              ]
            }
          },
          {
            "name": "originRef",
            "required": false,
            "in": "query",
            "description": "Código de indicação ou token do convite. Não é guardado (decisão 142): a\norigem basta para o próximo passo, e o app guarda o resto.",
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "next",
            "required": false,
            "in": "query",
            "description": "Página de volta (RN10); só caminho relativo do app (decisão 136).",
            "schema": {
              "maxLength": 1000,
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Vai para o Google (ou para o provedor de desenvolvimento)."
          }
        },
        "summary": "Vai para o Google, guardando o state e o PKCE num cookie assinado.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/google/callback": {
      "get": {
        "operationId": "GoogleLoginController_callback_v1",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Sucesso: APP_URL/entrar/google?step=&next=, com o cookie de sessão. Erro: APP_URL/entrar?error=google_unverified|blocked|google_failed (decisão 147)."
          }
        },
        "summary": "Volta do Google: abre a sessão e leva ao próximo passo (RN06 a RN08, RN10, RN11).",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "MeController_me_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedErrorBody"
                }
              }
            }
          }
        },
        "summary": "Quem está conectado; a leitura também renova a sessão (RN08).",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/referrals/{code}": {
      "get": {
        "operationId": "ReferralController_referral_v1",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralResponse"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralNotFoundErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedErrorBody"
                }
              }
            }
          }
        },
        "summary": "Indicador do link de indicação, para o destaque do cadastro (RN08, RN09 de Cadastro).",
        "tags": [
          "referrals"
        ]
      }
    }
  },
  "info": {
    "title": "Kore API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RateLimitedErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              429
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "RATE_LIMITED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "SessionExpiredErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              401
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "SESSION_EXPIRED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "OriginNotAllowedErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              403
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "ORIGIN_NOT_ALLOWED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "ValidationErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              400
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "Bad Request"
            ]
          },
          "message": {
            "description": "Um texto por campo inválido.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "TooSoonErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              429
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "TOO_SOON"
            ]
          },
          "message": {
            "type": "string"
          },
          "resendAvailableAt": {
            "type": "string",
            "description": "Quando o \"Reenviar código\" volta (RN04).",
            "format": "date-time"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "resendAvailableAt"
        ]
      },
      "TooManyCodeRequestsErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              429
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "TOO_MANY_REQUESTS"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryAfterMinutes": {
            "type": "number",
            "description": "\"Tente de novo em {minutos} minutos\" (RN04)."
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "retryAfterMinutes"
        ]
      },
      "RequestLoginChallengeBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "origin": {
            "type": "string",
            "description": "De onde a pessoa veio (RN06); padrão none.",
            "enum": [
              "invite",
              "referral",
              "couple_signup",
              "planner_signup",
              "none"
            ]
          },
          "originRef": {
            "type": "string",
            "description": "Código de indicação. Com origin invite, o token do convite é descartado: o\napp o guarda e volta ao convite depois do login (decisão 142).",
            "maxLength": 200
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestLoginChallengeResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "resendAvailableAt": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "resendAvailableAt"
        ]
      },
      "InvalidCodeErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              401
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "INVALID_CODE"
            ]
          },
          "message": {
            "type": "string"
          },
          "attemptsLeft": {
            "type": "number",
            "description": "Tentativas que ainda restam antes de o pedido cair (RN05)."
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "attemptsLeft"
        ]
      },
      "ChallengeExpiredErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              410
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "CHALLENGE_EXPIRED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "ChallengeLockedErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              410
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "CHALLENGE_LOCKED"
            ]
          },
          "message": {
            "type": "string"
          },
          "newCodeSent": {
            "type": "boolean",
            "description": "Se um código novo foi enviado sozinho (RN05)."
          },
          "retryAfterMinutes": {
            "type": "number",
            "description": "Só sem código novo: em quantos minutos pode pedir outro (decisão 150)."
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "newCodeSent"
        ]
      },
      "UserBlockedErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              403
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "USER_BLOCKED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "VerifyLoginChallengeBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        }
      },
      "VerifiedUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "isNew": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "isNew"
        ]
      },
      "VerifyLoginChallengeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/VerifiedUser"
          },
          "next": {
            "type": "string",
            "enum": [
              "invite",
              "couple_signup",
              "planner_signup",
              "home",
              "choose_profile"
            ]
          }
        },
        "required": [
          "user",
          "next"
        ]
      },
      "MeUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "platformRole": {
            "type": "string",
            "enum": [
              "none",
              "admin",
              "support"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "platformRole"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserResponse"
          },
          "activeProfile": {
            "type": "string",
            "nullable": true,
            "enum": [
              "couple",
              "planner",
              "seller"
            ]
          },
          "authenticatedAt": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "activeProfile",
          "authenticatedAt"
        ]
      },
      "ReferralNotFoundErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              404
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "REFERRAL_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "ReferralResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "juliana-prado"
          },
          "referrerName": {
            "type": "string",
            "example": "Juliana Prado"
          },
          "kind": {
            "enum": [
              "planner",
              "seller"
            ],
            "type": "string"
          },
          "discountPercent": {
            "type": "number",
            "nullable": true,
            "description": "Nulo quando o indicador está com o desconto desligado (RN09).",
            "example": 10
          }
        },
        "required": [
          "code",
          "referrerName",
          "kind",
          "discountPercent"
        ]
      }
    }
  }
}
