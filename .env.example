# Endereço da API (api-kore-api), sem barra no fim. A API precisa ter a origem do app em
# ALLOWED_ORIGINS (no local, http://localhost:5173).
VITE_API_URL=http://localhost:3000

# Site do casal (bundle público, `pnpm dev:site` na 5174): a linha da empresa no rodapé
# (Site público RN10; decisão 123 D9). Valores de exemplo; os reais ficam na infra.
VITE_COMPANY_NAME=Kore Tecnologia Ltda.
VITE_COMPANY_CNPJ=00.000.000/0001-00
VITE_COMPANY_ADDRESS=Av. Paulista, 1000, sala 101, São Paulo, SP, 01310-100
